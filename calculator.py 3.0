a = int(input("Введите первое число:"))
b = int(input("Введите второе число:"))
c = input("Введите действие, например /, *, + или -:)
if c == "+":
  d = a + b
  print(d)
elif c == "/" and b == 0:
  print("На ноль делить нельзя!")
elif c == "/":
  e = a / b
  print(e)
elif c == "-":
  f = a - b
  print(f)
elif c == "*":
  g = a * b
  print(g)
else:
  print("Неверная операция")
